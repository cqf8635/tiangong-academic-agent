# ==========================================
# 0815 系统环境变量模板 (可直接复制为 .env 使用)
# 全系统采用相对路径与动态检测，无需任何绝对路径硬编码
# ==========================================

# 1. 大模型 API 配置 (支持任何兼容 OpenAI 协议的接口，请填入自己的凭证)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# 2. 本地模型配置 (支持相对路径 ./models/... 或 ../models/...，也可直接使用 HuggingFace 模型 ID)
# 若模型存放在项目内 models 目录，直接填写 ./models/xxx
# 若未下载本地模型，可注释掉，系统将自动回退到官方预设模型或轻量模式
PAPER_EMBEDDING_MODEL=./models/embedding
PAPER_RERANKER_MODEL=./models/reranker
PAPER_USE_RERANKER=1
WHISPER_MODEL_PATH=./models/whisper-large-v3

# 3. 增强功能与超时配置
# 扫描版 PDF 在线多模态识别开关 (0: 关闭防消耗, 1: 开启自动解析)
ENABLE_VLM_OCR=0
# arXiv 学术在线检索防超时配置 (秒)
ARXIV_REQUEST_TIMEOUT=25
# 全局大模型调用统一超时配置 (秒)
LLM_TIMEOUT=100.0
