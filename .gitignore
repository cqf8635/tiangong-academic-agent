# ==============================================================================
# Git Ignore Rules for TianGong Academic Research Agent
# ==============================================================================

# 1. 绝对敏感与私有配置 (严禁上传开源仓库，防止 API Key 泄露)
.env
*.env.local
*.env.*.local

# 2. 本地用户数据与会话记录 (包含个人提问与测试历史)
.codex_backups/
sessions/
uploads/
data/chroma/
audio_cache/
records/
knowledge_db/
knowledge_db_clean/
static/extracted_images/
static/extracted_frames/
static/extracted_texts/
*.log
*.mp3
*.wav
*.mp4

# 3. 本地大模型权重与向量模型文件 (体积大，指导用户按需下载)
models/
whisper/
*.bin
*.safetensors
*.pt
*.pth
*.onnx

# 4. Python 运行与构建缓存
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# 5. 测试与代码质量分析缓存
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# 6. 编辑器与操作系统特定文件
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
